@model Book
@{ ViewData["Title"] = "Thêm sách"; }
<h2>Thêm sách</h2>

<div id="apiErrors" class="alert alert-danger d-none"></div>

<form id="createForm" asp-action="Create" enctype="multipart/form-data">
    <partial name="_Form" model="Model" />
    <button class="btn btn-success">Lưu</button>
    <a class="btn btn-secondary" asp-action="Index">Quay lại</a>
</form>

<script>
    // Form gọi Web API: POST /api/book -> thành công trả 201 Created
    const form = document.getElementById('createForm');
    const errBox = document.getElementById('apiErrors');

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (window.jQuery && !window.jQuery(form).valid()) return; // giữ kiểm tra dữ liệu ở trình duyệt

        errBox.classList.add('d-none');
        const res = await fetch('/api/book', { method: 'POST', body: new FormData(form) });// gọi

        if (res.status === 201) {
            sessionStorage.setItem('msg', 'Thêm sách thành công! (API trả về 201 Created)');
            window.location.href = '/Book';
            return;
        }

        // Lỗi (400...): hiện danh sách lỗi server trả về
        let messages = ['Lỗi ' + res.status];
        try {
            const data = await res.json();
            if (data.errors) messages = Object.values(data.errors).flat();
        } catch { }
        errBox.replaceChildren(...messages.map(m => {
            const d = document.createElement('div');
            d.textContent = m;
            return d;
        }));
        errBox.classList.remove('d-none');
    });
</script>
