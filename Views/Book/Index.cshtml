@model IEnumerable<Book>
@{ ViewData["Title"] = "Danh sách sách"; }

<div class="d-flex justify-content-between mb-3">
    <h2>Danh sách sách</h2>
    <a class="btn btn-success align-self-center" asp-action="Create">+ Thêm sách</a>
</div>

<form method="get" class="input-group mb-3">
    <input name="search" value="@ViewData["Search"]" class="form-control" placeholder="Tìm theo tên sách hoặc tác giả..." />
    <button class="btn btn-outline-primary">Tìm</button>
</form>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Hình ảnh</th><th>Tên sách</th><th>Tác giả</th><th>Thể loại</th><th>Giá (VNĐ)</th><th>Số lượng</th><th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var b in Model)
    {
        var first = b.Images.FirstOrDefault();
        <tr>
            <td>
                @if (first != null)
                {
                    <img src="@first.Url" alt="@b.Title" class="rounded" style="height:60px;width:60px;object-fit:cover" />
                    @if (b.Images.Count > 1) { <span class="badge bg-secondary">+@(b.Images.Count - 1)</span> }
                }
                else { <span class="text-muted">—</span> }
            </td>
            <td>@b.Title</td>
            <td>@b.Author</td>
            <td>@b.Category</td>
            <td>@b.Price.ToString("N0")</td>
            <td>@b.Quantity</td>
            <td class="text-end">
                <a class="btn btn-sm btn-info" asp-action="Detail" asp-route-id="@b.Id">Chi tiết</a>
                <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@b.Id">Sửa</a>
                <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@b.Id">Xóa</a>
            </td>
        </tr>
    }
    </tbody>
</table>
@if (!Model.Any()) { <p class="text-muted">Không có sách nào.</p> }
