@model Book
@{ ViewData["Title"] = "Chi tiết sách"; }
<h2>Chi tiết sách</h2>
<dl class="row">
    <dt class="col-sm-3">Tên sách</dt><dd class="col-sm-9">@Model.Title</dd>
    <dt class="col-sm-3">Tác giả</dt><dd class="col-sm-9">@Model.Author</dd>
    <dt class="col-sm-3">Thể loại</dt><dd class="col-sm-9">@Model.Category</dd>
    <dt class="col-sm-3">Giá (VNĐ)</dt><dd class="col-sm-9">@Model.Price.ToString("N0")</dd>
    <dt class="col-sm-3">Năm xuất bản</dt><dd class="col-sm-9">@Model.PublishedYear</dd>
    <dt class="col-sm-3">Số lượng</dt><dd class="col-sm-9">@Model.Quantity</dd>
    <dt class="col-sm-3">Mô tả</dt><dd class="col-sm-9">@Model.Description</dd>
</dl>
<a class="btn btn-warning" asp-action="Edit" asp-route-id="@Model.Id">Sửa</a>
<a class="btn btn-secondary" asp-action="Index">Quay lại</a>
