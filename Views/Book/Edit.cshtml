@model Book
@{ ViewData["Title"] = "Sửa sách"; }
<h2>Sửa sách</h2>
<form asp-action="Edit" enctype="multipart/form-data">
    <partial name="_Form" model="Model" />
    @if (Model.Images.Any())
    {
        <div class="mb-3">
            <label class="form-label">Ảnh hiện có (tích chọn để xóa)</label>
            <div class="d-flex flex-wrap gap-3">
                @foreach (var img in Model.Images)
                {
                    <div class="text-center">
                        <img src="@img.Url" class="img-thumbnail" style="height:100px" /><br />
                        <label><input type="checkbox" name="deleteImageIds" value="@img.Id" /> Xóa</label>
                    </div>
                }
            </div>
        </div>
    }
    <button class="btn btn-primary">Cập nhật</button>
    <a class="btn btn-secondary" asp-action="Index">Quay lại</a>
</form>
